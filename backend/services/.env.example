APP_ENV=local
SERVICE_ROLE=operator-api
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kairyx
DATA_BACKEND_MODE=gcp
LEGACY_HEADER_AUTH_ENABLED=false
API_ACCESS_KEY=

BOOTSTRAP_TENANT_ID=default
BOOTSTRAP_TENANT_NAME=Default Tenant
CORS_ALLOWED_ORIGINS=https://console.example.com

OIDC_ISSUER=https://issuer.example.com
OIDC_AUDIENCE=kairyx-operator
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=kairyx-console
OIDC_AUTHORIZE_URL=https://issuer.example.com/authorize
OIDC_TOKEN_URL=https://issuer.example.com/oauth/token
OIDC_LOGOUT_URL=https://issuer.example.com/logout
OIDC_JWT_SIGNING_SECRET=

GCP_PROJECT_ID=your-project-id
GCP_SECRET_PROJECT_ID=your-project-id
PUBSUB_TOPIC_NAME=kairyx-raw-shards
IMPORT_COMMAND_TOPIC=kairyx-import-jobs
PREDICTION_COMMAND_TOPIC=kairyx-prediction-jobs
EXPORT_COMMAND_TOPIC=kairyx-export-jobs

MAX_SQL_PREVIEW_ROWS_PER_TENANT=1000
MAX_IMPORT_JOBS_PER_TENANT=10
MAX_EXPORT_JOBS_PER_TENANT=20
MAX_COPILOT_REPORTS_PER_TENANT=50

SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
