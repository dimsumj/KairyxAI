# Local Docker Compose baseline.
APP_ENV=local
SERVICE_ROLE=operator-api
CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/kairyx
CONTROL_PLANE_CONNECT_TIMEOUT_SECONDS=3
DATA_BACKEND_MODE=mock
KAIRYX_PLATFORM_SURFACE=
KAIRYX_RUNTIME_DIR=
KAIRYX_MOCK_STORAGE_BACKEND=database
LEGACY_HEADER_AUTH_ENABLED=true
API_ACCESS_KEY=

BOOTSTRAP_TENANT_ID=default
BOOTSTRAP_TENANT_NAME=Default Tenant
BOOTSTRAP_PROJECT_ID=default
BOOTSTRAP_PROJECT_NAME=Default Project

CORS_ALLOWED_ORIGINS=http://localhost:8000
WORKER_SHARED_TOKEN=dev-worker-token

IMPORT_COMMAND_TOPIC=kairyx-import-jobs
PREDICTION_COMMAND_TOPIC=kairyx-prediction-jobs
EXPORT_COMMAND_TOPIC=kairyx-export-jobs
PUBSUB_TOPIC_NAME=kairyx-raw-shards

SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60

PORT=8080
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=300
