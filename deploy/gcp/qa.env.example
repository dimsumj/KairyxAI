# Internal QA environment deployed through deploy/gcp/deploy_cloud_run.sh
GCP_DEPLOYMENT_TIER=qa
GCP_SERVICE_PREFIX=qa

GCP_PROJECT_ID=your-qa-project-id
GCP_REGION=us-central1
GCP_ARTIFACT_REGISTRY_REPOSITORY=kairyx
GCP_IMAGE_NAME=kairyxai
GCP_RELEASE_TAG=qa-2026-04-06-r1
GCP_CLOUD_SQL_CONNECTION_NAME=your-qa-project-id:us-central1:kairyx-qa-db

# Prefer Direct VPC egress if your org allows it.
GCP_RUN_NETWORK=qa-vpc
GCP_RUN_SUBNET=qa-serverless
# If your org requires Serverless VPC Access, use this instead:
# GCP_VPC_CONNECTOR=projects/your-qa-project-id/locations/us-central1/connectors/qa-serverless

CONTROL_PLANE_DATABASE_URL_SECRET=qa-control-plane-db-url
WORKER_SHARED_TOKEN_SECRET=qa-worker-shared-token

# QA stays production-shaped for app validation but is still intended for internal access.
CORS_ALLOWED_ORIGINS=https://qa-console.example.internal
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=your-google-client-id.apps.googleusercontent.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
OIDC_LOGOUT_URL=
GOOGLE_OIDC_HOSTED_DOMAIN=example.com

GCP_SECRET_PROJECT_ID=your-qa-project-id
GCS_BUCKET_NAME=kairyx-qa-data
IMPORT_COMMAND_TOPIC=kairyx-qa-import-jobs
PREDICTION_COMMAND_TOPIC=kairyx-qa-prediction-jobs
EXPORT_COMMAND_TOPIC=kairyx-qa-export-jobs
PUBSUB_TOPIC_NAME=kairyx-qa-raw-shards

BOOTSTRAP_TENANT_ID=default
BOOTSTRAP_TENANT_NAME=Default Tenant
BOOTSTRAP_PROJECT_ID=default
BOOTSTRAP_PROJECT_NAME=Default Project

# Optional overrides:
# API_ACCESS_KEY_SECRET=qa-api-access-key
# OIDC_JWT_SIGNING_SECRET_SECRET=qa-oidc-jwt-signing-secret
# GCP_EXTRA_ENV_FILE=deploy/gcp/qa.extra.env.yaml
