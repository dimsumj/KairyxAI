{
  "serviceName": "kairyx-export-worker",
  "cluster": "arn:aws:ecs:<aws-region>:<account-id>:cluster/<cluster-name>",
  "taskDefinition": "kairyx-export-worker",
  "launchType": "FARGATE",
  "desiredCount": 1,
  "platformVersion": "LATEST",
  "enableExecuteCommand": true,
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "subnets": ["subnet-aaaaaaaa", "subnet-bbbbbbbb"],
      "securityGroups": ["sg-exportworker"],
      "assignPublicIp": "DISABLED"
    }
  }
}
